# Copy this file to ".env" and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
# The anon key is safe to expose in client-side code; Row Level Security
# policies (see supabase/schema.sql) are what actually protect user data.
#
# After editing this file, run `npm run config` to (re)write js/config.js,
# then commit js/config.js — it's checked into the repo on purpose so
# every production build actually has these values (see its own header
# comment for why).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Leave empty to hide the Sound-Effects search section entirely.
# Free read-only key from https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=
