# Copy this file to ".env" if you want to regenerate js/config.js via
# `npm run config` (see scripts/gen-config.js) - mainly useful for rotating
# FREESOUND_API_KEY/JAMENDO_CLIENT_ID. API_BASE_URL rarely needs to change;
# editing js/config.js directly works fine too.
#
# The real backend credentials (MySQL password etc.) live in
# server/config.php, NOT here - see server/config.example.php instead.

# Path (or full URL) to the server/api/ backend. Leave as "/server/api" for
# a same-origin deploy (the default and recommended setup).
API_BASE_URL=/server/api

# Optional. Leave empty to hide the Sound-Effects search tab entirely.
# Free read-only key from https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# Optional. Leave empty to hide the Music search tab entirely.
# Free client_id from https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=
